# ============================================================================
# SquadPulse — Environment Variables
# ============================================================================

# NextAuth / Auth.js Secret Key
# Generate with: `npx auth secret` or `openssl rand -base64 32`
AUTH_SECRET=squadpulse-production-secure-auth-secret-key-32chars
NEXTAUTH_SECRET=squadpulse-production-secure-auth-secret-key-32chars

# Application URL (for production deployments like Vercel)
# NEXTAUTH_URL=https://squadpulse-phi.vercel.app

# Google OAuth 2.0 Credentials (Optional for local dev, 1-Click Demo is zero-config)
# Obtain from Google Cloud Console: https://console.cloud.google.com/apis/credentials
# Authorized JavaScript Origins: http://localhost:3000, https://squadpulse-phi.vercel.app
# Authorized Redirect URI: http://localhost:3000/api/auth/callback/google, https://squadpulse-phi.vercel.app/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
